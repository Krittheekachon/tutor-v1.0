# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase Dashboard > Project Settings > API
# ใช้ได้เฉพาะ Project URL และ Publishable Key (หรือ anon key แบบเก่า) เท่านั้น
# ห้ามใส่ service_role, secret key, database password หรือรหัสผ่านเจ้าของในไฟล์นี้
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
